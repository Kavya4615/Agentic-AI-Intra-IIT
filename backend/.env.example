# ============================================================
#  Environment Configuration — Clinical Decision-Support System
# ============================================================
# Copy this file to .env and fill in the values before running.
# The .env file is gitignored and should NEVER be committed.

# --- Phase 7: AI Agent ---
# Required for live LLM explanations. If not set, the agent
# will fall back to a structured mock response for testing.
OPENAI_API_KEY=your-openai-api-key-here

# LLM Model to use (default: gpt-4o-mini for cost efficiency)
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo
AGENT_MODEL=gpt-4o-mini

# --- Database (Phase future) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/cdss_db
